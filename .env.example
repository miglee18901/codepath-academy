# Local Docker configuration. Copy to .env; never commit secrets.
DB_PASSWORD=academy_local
DB_ROOT_PASSWORD=root_local
DEMO_DATA=true
JWT_SECRET=MDEyMzQ1Njc4OWFiY2RlZjAxMjM0NTY3ODlhYmNkZWY=
# Mailpit receives local OTP and purchase emails at http://localhost:8025.
MAIL_HOST=mailpit
MAIL_PORT=1025
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_FROM=no-reply@codepath.local
MAIL_AUTH=false
MAIL_STARTTLS=false
# For Gmail: host=smtp.gmail.com, port=587, auth/starttls=true, application password.
PAYOS_CLIENT_ID=local-placeholder
PAYOS_API_KEY=local-placeholder
PAYOS_CHECKSUM_KEY=local-placeholder
RECAPTCHA_SECRET_KEY=6LeIxAcTAAAAAGG-vFI1TnRWxMZNFuojJ4WifJWe
# Leave empty to call /api on the website's domain through the frontend proxy.
FRONTEND_API_URL=
FRONTEND_URL=http://localhost:5173
# Blank: derive Passkey RP ID and exact allowed origin from FRONTEND_URL.
# Use http://localhost:5173 locally (avoid switching to 127.0.0.1).
# Production example: PASSKEY_RP_ID=academy.example.com
# PASSKEY_ORIGINS=https://academy.example.com
PASSKEY_RP_ID=
PASSKEY_ORIGINS=
# OAuth providers stay disabled until both credentials are configured.
# Register these callback URLs with each provider:
# http://localhost:5173/api/auth/oauth2/callback/google
# http://localhost:5173/api/auth/oauth2/callback/github
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
# Blank: use FRONTEND_URL; set only when the public backend origin is different.
OAUTH_CALLBACK_BASE_URL=
# Set true when the OAuth callback is served over HTTPS.
OAUTH_COOKIE_SECURE=false
RECAPTCHA_SITE_KEY=6LeIxAcTAAAAAJcZVRqyHh71UMIEGNQ_MXjiZKhI

# Mux Free: create a Video read/write API token and a URL signing key.
# Paste the Base64 private key on one line. Keep all four values server-side.
MUX_TOKEN_ID=
MUX_TOKEN_SECRET=
MUX_SIGNING_KEY_ID=
MUX_SIGNING_PRIVATE_KEY=

# Optional ngrok Docker override (see docs/ngrok.md).
# Copy your assigned hostname only, without https:// or a trailing slash.
NGROK_DOMAIN=
NGROK_AUTHTOKEN=

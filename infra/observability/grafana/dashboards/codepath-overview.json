{
  "uid": "codepath-overview",
  "title": "CodePath - Application overview",
  "tags": [
    "codepath",
    "observability"
  ],
  "schemaVersion": 39,
  "version": 1,
  "editable": false,
  "refresh": "15s",
  "time": {
    "from": "now-30m",
    "to": "now"
  },
  "templating": {
    "list": [
      {
        "name": "deployment",
        "type": "query",
        "label": "Environment",
        "datasource": {
          "type": "prometheus",
          "uid": "prometheus"
        },
        "query": "label_values(up{job=\"codepath-backend\"}, deployment)",
        "refresh": 1,
        "includeAll": true,
        "allValue": ".*",
        "current": {
          "text": "All",
          "value": "$__all"
        }
      }
    ]
  },
  "panels": [
    {
      "id": 1,
      "title": "Backend available",
      "type": "timeseries",
      "gridPos": {
        "x": 0,
        "y": 0,
        "w": 12,
        "h": 8
      },
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "up{job=\"codepath-backend\",deployment=~\"$deployment\"}",
          "legendFormat": "{{deployment}} {{uri}} {{outcome}} {{operation}} {{id}}"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short"
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        }
      }
    },
    {
      "id": 2,
      "title": "Requests / second",
      "type": "timeseries",
      "gridPos": {
        "x": 12,
        "y": 0,
        "w": 12,
        "h": 8
      },
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by(deployment) (rate(http_server_requests_seconds_count{job=\"codepath-backend\",deployment=~\"$deployment\",uri!~\"/actuator.*\"}[5m]))",
          "legendFormat": "{{deployment}} {{uri}} {{outcome}} {{operation}} {{id}}"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "reqps"
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        }
      }
    },
    {
      "id": 3,
      "title": "HTTP 5xx ratio",
      "type": "timeseries",
      "gridPos": {
        "x": 0,
        "y": 8,
        "w": 12,
        "h": 8
      },
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "(sum by(deployment)(rate(http_server_requests_seconds_count{job=\"codepath-backend\",deployment=~\"$deployment\",status=~\"5..\"}[5m])) or on(deployment) (0 * sum by(deployment)(rate(http_server_requests_seconds_count{job=\"codepath-backend\",deployment=~\"$deployment\"}[5m])))) / clamp_min(sum by(deployment)(rate(http_server_requests_seconds_count{job=\"codepath-backend\",deployment=~\"$deployment\"}[5m])),0.001)",
          "legendFormat": "{{deployment}} {{uri}} {{outcome}} {{operation}} {{id}}"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "percentunit"
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        }
      }
    },
    {
      "id": 4,
      "title": "HTTP p95 by route",
      "type": "timeseries",
      "gridPos": {
        "x": 12,
        "y": 8,
        "w": 12,
        "h": 8
      },
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "histogram_quantile(0.95,sum by(le,uri,deployment)(rate(http_server_requests_seconds_bucket{job=\"codepath-backend\",deployment=~\"$deployment\",uri!~\"/actuator.*\"}[5m])))",
          "legendFormat": "{{deployment}} {{uri}} {{outcome}} {{operation}} {{id}}"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "s"
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        }
      }
    },
    {
      "id": 5,
      "title": "Recent application logs (open Explore for trace links)",
      "type": "logs",
      "gridPos": {
        "x": 0,
        "y": 16,
        "w": 24,
        "h": 10
      },
      "datasource": {
        "type": "loki",
        "uid": "loki"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "{service_name=\"codepath-academy-backend\"} | deployment_environment_name=~\"$deployment\""
        }
      ],
      "options": {
        "showTime": true,
        "wrapLogMessage": true,
        "sortOrder": "Descending"
      }
    }
  ]
}

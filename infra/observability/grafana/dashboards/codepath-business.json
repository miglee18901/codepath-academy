{
  "uid": "codepath-business",
  "title": "CodePath - Authentication and email",
  "tags": [
    "codepath",
    "observability"
  ],
  "schemaVersion": 39,
  "version": 1,
  "editable": false,
  "refresh": "15s",
  "time": {
    "from": "now-30m",
    "to": "now"
  },
  "templating": {
    "list": [
      {
        "name": "deployment",
        "type": "query",
        "label": "Environment",
        "datasource": {
          "type": "prometheus",
          "uid": "prometheus"
        },
        "query": "label_values(up{job=\"codepath-backend\"}, deployment)",
        "refresh": 1,
        "includeAll": true,
        "allValue": ".*",
        "current": {
          "text": "All",
          "value": "$__all"
        }
      }
    ]
  },
  "panels": [
    {
      "id": 12,
      "title": "Authentication results / 5 minutes",
      "type": "timeseries",
      "gridPos": {
        "x": 0,
        "y": 0,
        "w": 12,
        "h": 8
      },
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by(deployment,operation,outcome)(increase(codepath_auth_requests_total{job=\"codepath-backend\",deployment=~\"$deployment\"}[5m]))",
          "legendFormat": "{{deployment}} {{uri}} {{outcome}} {{operation}} {{id}}"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short"
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        }
      }
    },
    {
      "id": 13,
      "title": "Email delivery attempts / 5 minutes",
      "type": "timeseries",
      "gridPos": {
        "x": 12,
        "y": 0,
        "w": 12,
        "h": 8
      },
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by(deployment,outcome)(increase(codepath_email_deliveries_total{job=\"codepath-backend\",deployment=~\"$deployment\"}[5m]))",
          "legendFormat": "{{deployment}} {{uri}} {{outcome}} {{operation}} {{id}}"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short"
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        }
      }
    },
    {
      "id": 14,
      "title": "Mean email processing duration",
      "type": "timeseries",
      "gridPos": {
        "x": 0,
        "y": 8,
        "w": 12,
        "h": 8
      },
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by(deployment,outcome)(rate(codepath_email_processing_seconds_sum{job=\"codepath-backend\",deployment=~\"$deployment\"}[5m])) / sum by(deployment,outcome)(rate(codepath_email_processing_seconds_count{job=\"codepath-backend\",deployment=~\"$deployment\"}[5m]))",
          "legendFormat": "{{deployment}} {{uri}} {{outcome}} {{operation}} {{id}}"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "s"
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        }
      }
    }
  ]
}
